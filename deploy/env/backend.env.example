# Production environment configuration for Course App Backend
# Path on Ubuntu server: /var/www/course-app/backend/.env

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Supabase production credentials (publishable key only, service_role strictly forbidden)
SUPABASE_URL=https://epbglesngndopojuffed.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_production_publishable_key_here

# Allowed frontend origins (exact origin without trailing slashes, comma-separated)
FRONTEND_ORIGIN=https://course.muntyandev.ru,http://localhost:5173
