# Build-time environment variables for Course App Frontend Vite production build
# Path on Ubuntu server or local build: /var/www/course-app/frontend/.env.production

# Supabase project URL and anon/publishable key
VITE_SUPABASE_URL=https://epbglesngndopojuffed.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_production_publishable_key_here

# Public Node Express API base URL without trailing slash and without /api suffix
VITE_API_BASE_URL=https://api-course.muntyandev.ru
